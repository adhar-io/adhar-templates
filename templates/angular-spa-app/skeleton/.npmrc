# Adhar UI packages are published to the in-cluster Nexus npm-hosted repository
# by the adhar-ui release pipeline (the Gitea npm registry holds nothing, and a
# build pointed there fails on every @adhar-ui package with 404). Scope
# @adhar-ui to it; anonymous read is enabled on this repository.
@adhar-ui:registry=http://nexus.adhar-system.svc.cluster.local:8081/repository/npm-hosted/
