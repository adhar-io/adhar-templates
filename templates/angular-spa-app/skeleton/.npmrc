# Adhar UI packages are published to the in-cluster Gitea npm registry by the
# adhar-ui release pipeline. Scope @adhar-ui to it (public read; add an
# _authToken line if your Gitea org packages are private).
@adhar-ui:registry=http://gitea-http.adhar-system.svc.cluster.local:3000/api/packages/adhar/npm/
