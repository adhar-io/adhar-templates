{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "${{ values.name }}": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/${{ values.name }}",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "public" }{% if values.withLocalisation %},
              { "glob": "*.json", "input": "src/i18n", "output": "i18n" }{% endif %}
            ],
            "styles": ["src/styles.css"],
            "scripts": [],
            "allowedCommonJsDependencies": ["ua-parser-js", "@opentelemetry/api", "@opentelemetry/otlp-transformer", "@opentelemetry/semantic-conventions"]
          },
          "configurations": {
            "production": {
              "outputHashing": "all"{% if values.withLocalisation %},
              "conditions": ["module", "production"]{% endif %}
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "${{ values.name }}:build:production" },
            "development": { "buildTarget": "${{ values.name }}:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
