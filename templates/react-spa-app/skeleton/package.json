{
  "name": "${{ values.name }}",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:nginx": "bash e2e/nginx/test.sh"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@adhar-ui/react": "^0.1.0",
    "@adhar-ui/tokens": "^0.1.0",
    "@adhar-ui/icons": "^0.1.0",
    "@adhar-ui/utils": "^0.1.0",
    "@grafana/faro-web-sdk": "2.12.1",
    "@grafana/faro-web-tracing": "2.12.1"{% if values.withAnalytics %},
    "posthog-js": "1.438.3"{% endif %}{% if values.withLocalisation %},
    "@tolgee/react": "7.3.0"{% endif %}
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@adhar-ui/tailwind-preset": "^0.1.0"
