{
  "name": "${{ values.name }}",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "npm run typecheck && npm run lint",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:nginx": "bash e2e/nginx/test.sh"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@adhar-ui/react": "^0.1.0",
    "@adhar-ui/tokens": "^0.1.0",
    "@adhar-ui/icons": "^0.1.0",
    "@adhar-ui/utils": "^0.1.0",
    "@grafana/faro-web-sdk": "2.12.1",
    "@grafana/faro-web-tracing": "2.12.1"{% if values.withAnalytics %},
    "posthog-js": "1.438.3"{% endif %}{% if values.withLocalisation %},
    "@tolgee/react": "7.3.0"{% endif %}
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/k6": "~1.3.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.7",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@adhar-ui/tailwind-preset": "^0.1.0"
  },
  "overrides": {
    "@grafana/faro-core": "2.12.1"
  }
}
