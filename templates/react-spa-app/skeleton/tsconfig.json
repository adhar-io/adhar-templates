  //                       Node 24 strips the types itself)
  //   tsconfig.perf.json  perf/ — the k6 load test (k6 runs TypeScript itself)
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.perf.json" }
  ]
}
