<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Adhar Kit parent — production defaults (Spring Boot, observability,
       security, resilience). Resolved from the platform's Nexus (see
       settings.xml). -->
  <parent>
    <groupId>com.adhar.kit</groupId>
    <artifactId>adhar-kit-parent</artifactId>
    <version>0.1.0</version>
    <relativePath/>
  </parent>

  <groupId>io.adhar.service</groupId>
  <artifactId>${{ values.name }}</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>${{ values.name }}</name>
  <description>${{ values.description }}</description>

  <dependencies>
        <!-- Serves /actuator/prometheus. The platform's PodMonitor scrapes it for
             request rate, status codes and latency (catalog Metrics tab and the
             per-application Grafana dashboard); exposing the endpoint without
             this registry answers 404, which adhar-kit reports as a 500. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
    <!-- Batteries-included starter: web, actuator/health, tracing, metrics,
         logging, security, resilience. -->
    <dependency>
      <groupId>com.adhar.kit</groupId>
      <artifactId>adhar-kit-starter</artifactId>
    </dependency>
{%- if values.withDatabase %}
    <dependency>
      <groupId>com.adhar.kit</groupId>
      <artifactId>adhar-kit-persistence</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
{%- endif %}
  </dependencies>

  <!-- Security floors above adhar-kit-parent 0.1.0. The supply-chain image
       scan (trivy, HIGH/CRITICAL, exit-code 1) refuses an image carrying
       these, so a freshly scaffolded service could not pass its own pipeline:
         CVE-2026-106451  at.yawk.lz4:lz4-java 1.10.1 (via kafka-clients) -> 1.11.4
         io.kubernetes:client-java (via adhar-kit-kubernetes)             -> 27.0.0
       A released parent POM is immutable in Nexus, so the pins live here until
       the parent that carries them is released; then delete this block
       (`mvn dependency:tree` showing the same versions without it is the
       signal). Explicit dependencyManagement, not a property: a property the
       BOM does not use is silently ignored. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>at.yawk.lz4</groupId>
        <artifactId>lz4-java</artifactId>
        <version>1.11.4</version>
      </dependency>
      <dependency>
        <groupId>io.kubernetes</groupId>
        <artifactId>client-java</artifactId>
        <version>27.0.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- Produces the executable jar buildpacks turn into the image. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <!-- Also declared for dependency resolution; parent resolution uses
       settings.xml (BP_MAVEN_SETTINGS_PATH), which mirrors these to the same
       Nexus group. The platform publishes adhar-kit to Nexus `maven-hosted`,
       never to the Gitea Maven registry — pointing here at Gitea failed the
       build with "adhar-kit-parent:pom:0.1.0 (absent)". -->
  <repositories>
    <repository>
      <id>adhar-nexus</id>
      <url>http://nexus.adhar-system.svc.cluster.local:8081/repository/maven-public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>adhar-nexus</id>
      <url>http://nexus.adhar-system.svc.cluster.local:8081/repository/maven-public/</url>
    </pluginRepository>
  </pluginRepositories>
</project>
