<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Adhar Kit parent — production defaults (Spring Boot, observability,
       security, resilience). Resolved from the platform's Nexus (see
       settings.xml). -->
  <parent>
    <groupId>com.adhar.kit</groupId>
    <artifactId>adhar-kit-parent</artifactId>
    <version>0.1.0</version>
    <relativePath/>
  </parent>

  <groupId>io.adhar.service</groupId>
  <artifactId>${{ values.name }}</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>${{ values.name }}</name>
  <description>${{ values.description }}</description>

  <dependencies>
    <!-- Batteries-included starter: web, actuator/health, tracing, metrics,
         logging, security, resilience. -->
    <dependency>
      <groupId>com.adhar.kit</groupId>
      <artifactId>adhar-kit-starter</artifactId>
    </dependency>
{%- if values.withDatabase %}
    <dependency>
      <groupId>com.adhar.kit</groupId>
      <artifactId>adhar-kit-persistence</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
{%- endif %}
{%- if values.withCache %}
    <!-- Valkey cache through Adhar Kit: adhar-kit-cache registers its Redis cache
         manager as Spring's CacheManager on top of Spring Boot's Redis connection
         (spring.data.redis.url), with typed JSON values, adhar.cache.* TTL and key
         prefix, and Valkey as the L2 of @MultiLevelCache. The Redis client itself
         is optional in the kit, so it is declared here. -->
    <dependency>
      <groupId>com.adhar.kit</groupId>
      <artifactId>adhar-kit-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
{%- endif %}
{%- if values.withKafka %}
    <!-- Kafka. Spring Boot 4 moved Kafka auto-configuration into its own
         module; this starter brings it and spring-kafka. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
    </dependency>
{%- endif %}
  </dependencies>

  <build>
    <plugins>
      <!-- Produces the executable jar buildpacks turn into the image. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <!-- Also declared for dependency resolution; parent resolution uses
       settings.xml (BP_MAVEN_SETTINGS_PATH), which mirrors these to the same
       Nexus group. The platform publishes adhar-kit to Nexus `maven-hosted`,
       never to the Gitea Maven registry — pointing here at Gitea failed the
       build with "adhar-kit-parent:pom:0.1.0 (absent)". -->
  <repositories>
    <repository>
      <id>adhar-nexus</id>
      <url>http://nexus.adhar-system.svc.cluster.local:8081/repository/maven-public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>adhar-nexus</id>
      <url>http://nexus.adhar-system.svc.cluster.local:8081/repository/maven-public/</url>
    </pluginRepository>
  </pluginRepositories>
</project>
