{
  "name": "${{ values.name }}",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node server.mjs",
    "test": "node --test src/server/*.test.ts",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@tanstack/react-start": "^1.169.0",
    "@tanstack/react-router": "^1.170.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@adhar-ui/react": "^0.1.0",
    "@adhar-ui/tokens": "^0.1.0",
    "@adhar-ui/utils": "^0.1.0",
    "@grafana/faro-web-sdk": "2.12.1",
    "@grafana/faro-web-tracing": "2.12.1",{% if values.withAnalytics %}
    "posthog-js": "1.438.3",{% endif %}
    "prom-client": "15.1.3",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "srvx": "^1.0.5"{% if values.withLocalisation %},
    "@tolgee/react": "7.3.0"{% endif %}{% if values.withDatabase %},
    "pg": "^8.12.0"{% endif %}
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@adhar-ui/tailwind-preset": "^0.1.0",
    "typescript": "^5.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"{% if values.withDatabase %},
    "@types/pg": "^8.11.0"{% endif %}
  },
  "overrides": {
    "@grafana/faro-core": "2.12.1"
  }
}
