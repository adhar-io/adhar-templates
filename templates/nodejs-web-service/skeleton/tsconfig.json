{
  // TypeScript for everything in this repository: src/, test/ and
  // eslint.config.mts. The editor, `npm run typecheck` and typescript-eslint
  // read this file; tsconfig.build.json compiles src/ alone into dist/.
  "compilerOptions": {
    // Node.js 24, the runtime project.toml pins (the @tsconfig/node24 base).
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],
    // package.json says "type": "commonjs", so NodeNext compiles to CommonJS.
    // That is what the OpenTelemetry preload in deploy/base/rollout.yaml
    // (`--require`) instruments: express, http and pg are traced as they are
    // required. OpenTelemetry's hook for ES modules is still experimental.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    // Each file compiles on its own, as tsx (the tests, `npm run dev`) does it.
    "isolatedModules": true,
    // Strict, and the checks strict leaves out.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // Stack traces name the .ts line: src/lib/source-maps.ts turns Node's
    // source-map support on for the maps the build writes beside dist/*.js.
    "sourceMap": true,
    "noEmit": true
  },
  "include": ["src", "test", "eslint.config.mts"]
}
