{
  "name": "${{ values.name }}",
  "version": "1.0.0",
  "description": ${{ values.description | dump }},
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "node --import tsx --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "npm run lint && npm run typecheck && npm run build",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "test:integration": "npm run build && node --import tsx --test \"test/integration/**/*.test.ts\""
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "express": "^4.19.2",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0"{% if values.withDatabase %},
    "pg": "^8.12.0"{% endif %}
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
{%- if values.withDatabase %}
    "@types/pg": "^8.23.1",
{%- endif %}
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
